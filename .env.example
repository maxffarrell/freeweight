# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

# Docker Compose only: set a persistent, URL-safe password (openssl rand -hex 32).
# For local development with Compose, use the same password in DATABASE_URL.
# Existing database volumes keep their password; changing this does not rotate it.
POSTGRES_PASSWORD=

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Leroa Profile service origin (an install of Leroa running LEROA_PROFILE_HUB=true).
# Enables "Continue with Leroa" unified sign-in + shared customer contact sync.
FREEWEIGHT_PROFILE_URL=

# Public demo mode: throwaway sample workspaces, risky features disabled.
FREEWEIGHT_DEMO=

# Freeweight Cloud (only the hosted product sets this). Enables per-workspace
# Stripe Connect instead of the install-wide Stripe account.
FREEWEIGHT_CLOUD=

# Enterprise license key for paid administrative features; not needed for SSO, passkeys or BYOK AI.
FREEWEIGHT_ENTERPRISE_KEY=

# AI features (BYOK; optional; no enterprise license required). Provider: openai (default; also works with
# any OpenAI-compatible endpoint like Ollama, OpenRouter or LiteLLM) or anthropic.
# FREEWEIGHT_AI_* powers the freeform text features (workout plans, class
# descriptions, roster briefs, member month summaries).
FREEWEIGHT_AI_PROVIDER=
FREEWEIGHT_AI_MODEL=
FREEWEIGHT_AI_KEY=
FREEWEIGHT_AI_BASE_URL=

# AI decision calls (optional split). Structured-JSON features (announcement/
# win-back/issue-reply drafts, gym insights, program generation, weekly
# insights email) run on a separate OpenAI-spec-only model — handy for a
# cheaper/structured-tuned model. Each falls back to the FREEWEIGHT_AI_* value
# above, so leaving them unset keeps one key for everything. OpenAI-spec
# /chat/completions only — set explicitly when FREEWEIGHT_AI_PROVIDER=anthropic.
FREEWEIGHT_AI_DECISION_KEY=
FREEWEIGHT_AI_DECISION_MODEL=
FREEWEIGHT_AI_DECISION_BASE_URL=

# Email (optional). Without a provider, emails are only written to the server log.
EMAIL_FROM=
RESEND_API_KEY=
SMTP_URL=

# Protects /api/cron (daily membership billing + demo cleanup).
CRON_SECRET=

# Online member payments (optional). Webhook endpoint: /api/payments/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
