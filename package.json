{
	"name": "freeweight",
	"private": true,
	"version": "0.1.3",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"start": "node scripts/migrate.ts && PROTOCOL_HEADER=x-forwarded-proto node scripts/server.ts",
		"changeset": "pnpm dlx @changesets/cli@2.31.1",
		"release:version": "pnpm changeset version && pnpm install --ignore-scripts && pnpm exec prettier --write package.json pnpm-lock.yaml CHANGELOG.md .changeset",
		"preinstall": "node scripts/check-node.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/geist": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.72.0",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@types/nodemailer": "^8.0.2",
		"@types/qrcode": "^1.5.6",
		"auth": "^1.7.23",
		"bits-ui": "^2.21.0",
		"cn": "^0.5.2",
		"drizzle-kit": "^0.31.11",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"formsnap": "^2.1.0",
		"globals": "^17.14.0",
		"layerchart": "^2.10.1",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"sveltekit-superforms": "^3.1.0",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.72.2",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@better-auth/api-key": "^1.7.23",
		"@better-auth/passkey": "^1.7.23",
		"@better-auth/sso": "^1.7.23",
		"@freeweight/sdk": "workspace:*",
		"@shadcn-svelte/primitives": "^0.0.1",
		"@sveltejs/adapter-vercel": "^7.0.3",
		"@types/d3-scale": "^4.0.9",
		"better-auth": "^1.7.23",
		"d3-scale": "^4.0.3",
		"drizzle-orm": "^0.45.4",
		"nodemailer": "^10.5.0",
		"postgres": "^4.1.1",
		"qrcode": "^1.5.4",
		"runed": "^0.38.0",
		"shiki": "^4.6.0",
		"stripe": "~23.1.0",
		"valibot": "^1.5.0"
	},
	"engines": {
		"node": "^24.22.1 || ^26.12.1"
	}
}
